# Path to notepad++.exe (defaults to Program Files if unset)
NOTEPADPP_EXE=C:/Program Files/Notepad++/notepad++.exe

# Live Notepad++ session.xml (defaults to %APPDATA%\Notepad++\session.xml)
# NOTEPADPP_SESSION_XML=

# Default working folder for relative open/new paths
# (defaults to %USERPROFILE%\Documents\NotepadPP-Notes if unset)
NOTEPADPP_WORKDIR=

# Where named session snapshots are stored
# NOTEPADPP_SESSION_STORAGE_DIR=
